# Copy to `.env` (or set these in your host's build environment) before building.
#
# Vite inlines VITE_* values at BUILD time, so changing them requires a rebuild.

# A real inbox controlled by the founder. The public build defaults to
# crezora.admin@gmail.com; set this only to override that address.
VITE_CONTACT_EMAIL=

# Only set this if a real, operator-owned translation API exists. When unset,
# the BhashaVerse studio stays disabled and does not simulate translation.
VITE_TRANSLATION_ENDPOINT=
